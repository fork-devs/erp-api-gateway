# Kong Gateway Environment Variables (Local / Azure Container Apps)

# Distributed Rate Limiting (Azure Cache for Redis uses port 6380 + TLS)
RATE_LIMIT_POLICY=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_SSL_VERIFY=false
REDIS_DATABASE=0

# CORS Allowed Origin (never use wildcard * with credentials: true in production)
CORS_ALLOWED_ORIGIN=https://app.driveos.pe

# Kong OSS Native JWT Plugin (RS256)
JWT_ISSUER=erp-auth-service
JWT_PUBLIC_KEY=
